# ------------------------------------------------------------------
# MaideenAttendee environment
# Copy to .env.local and fill in real values. Never commit secrets.
# ------------------------------------------------------------------

# Supabase (hosted project or `npx supabase start` output)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Paystack — https://dashboard.paystack.com/#/settings/developers
# Optional: the platform administrator can store these under Platform > Payment gateways instead.
PAYSTACK_SECRET_KEY=
# Not required for checkout. Recorded so the dashboard can show which account and mode (test/live) is connected.
PAYSTACK_PUBLIC_KEY=

# Flutterwave — https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_PUBLIC_KEY=

# Required to let the platform administrator store gateway keys from the dashboard.
# The value encrypts every credential saved through Platform > Payment gateways.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it makes previously stored credentials unreadable (re-enter them afterwards).
SECRETS_ENCRYPTION_KEY=

# Public base URL (used for payment callbacks and webhooks)
APP_URL=http://localhost:3000

# Platform owner account created by `npm run db:seed`.
# Leave the password empty to have the seed generate a random one and print it.
SUPER_ADMIN_EMAIL=superadmin@maideenattendee.app
SUPER_ADMIN_PASSWORD=
